{
    "name": "elezerk/rpcci-lapaz",
    "description": "A Laravel Nova theme.",
    "keywords": [
        "laravel",
        "nova"
    ],
    "license": "MIT",
    "require": {
        "php": ">=7.1.0"
    },
    "autoload": {
        "psr-4": {
            "Elezerk\\RpcciLapaz\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Elezerk\\RpcciLapaz\\ThemeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
